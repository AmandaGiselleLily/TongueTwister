import util
import consonant_to_vector
import vowel_to_vector

def onset(syllable):

    construct = util.split_syllable(syllable)

    manner_vector = consonant_to_vector.manner_vector(construct[0])
    place_vector = consonant_to_vector.place_vector(construct[0])
    cluster_vector = consonant_to_vector.cluster_vector(construct[0])

    return [manner_vector, place_vector, cluster_vector]

def offset(syllable):

    construct = util.split_syllable(syllable)

    manner_vector = consonant_to_vector.manner_vector(construct[1])
    place_vector = consonant_to_vector.place_vector(construct[1])
    cluster_vector = consonant_to_vector.cluster_vector(construct[1])

    return [manner_vector, place_vector, cluster_vector]

def onset_to_offset(syllable):

    construct = util.split_syllable(syllable)

    onset_manner_vector = consonant_to_vector.manner_vector(construct[0])
    onset_place_vector = consonant_to_vector.place_vector(construct[0])
    onset_cluster_vector = consonant_to_vector.cluster_vector(construct[0])

    offset_manner_vector = consonant_to_vector.manner_vector(construct[1])
    offset_place_vector = consonant_to_vector.place_vector(construct[1])
    offset_cluster_vector = consonant_to_vector.cluster_vector(construct[1])

    return [onset_manner_vector, onset_place_vector, onset_cluster_vector, offset_manner_vector, offset_place_vector, offset_cluster_vector]